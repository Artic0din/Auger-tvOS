{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "comment": "tvOS permission prompt text the system shows when Auger first asks for local network access. Keep it in step with iosApp/iosApp/tvOS-Info.plist.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Auger شبكتك المحلية للعثور على خوادم Silo، ولإعداد Auger على Apple TV والتحكم فيه."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger използва локалната ви мрежа, за да намира сървъри на Silo и да настройва и управлява Auger на вашия Apple TV."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger utilitza la xarxa local per trobar servidors de Silo i per configurar i controlar Auger a l’Apple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger používá vaši místní síť k vyhledání serverů Silo a k nastavení a ovládání aplikace Auger na vašem Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger bruger dit lokale netværk til at finde Silo-servere og til at konfigurere og styre Auger på dit Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger verwendet dein lokales Netzwerk, um Silo-Server zu finden und um Auger auf deinem Apple TV einzurichten und zu steuern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Auger χρησιμοποιεί το τοπικό σας δίκτυο για να βρίσκει διακομιστές Silo και για να ρυθμίζει και να ελέγχει το Auger στο Apple TV σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger uses your local network to find Silo servers, and to set up and control Auger on your Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger usa tu red local para encontrar servidores de Silo y para configurar y controlar Auger en tu Apple TV."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger kasutab teie kohtvõrku, et leida Silo servereid ning seadistada ja juhtida Augerit teie Apple TV-s."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger käyttää lähiverkkoasi Silo-palvelimien löytämiseen sekä Augerin määrittämiseen ja ohjaamiseen Apple TV:ssäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger utilise votre réseau local pour trouver des serveurs Silo, et pour configurer et contrôler Auger sur votre Apple TV."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשת המקומית שלך משמשת את Auger כדי למצוא שרתי Silo, וכדי להגדיר את Auger ב-Apple TV ולשלוט בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Silo सर्वर ढूँढने के लिए और आपके Apple TV पर Auger को सेट अप और कंट्रोल करने के लिए Auger आपके लोकल नेटवर्क का इस्तेमाल करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger upotrebljava vašu lokalnu mrežu za pronalaženje poslužitelja Silo te za postavljanje i upravljanje aplikacijom Auger na vašem Apple TV-u."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Auger a helyi hálózatot használja a Silo szerverek megkereséséhez, valamint az Apple TV-n futó Auger beállításához és vezérléséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger menggunakan jaringan lokal Anda untuk menemukan server Silo, serta untuk menyiapkan dan mengontrol Auger di Apple TV Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger usa la tua rete locale per trovare i server Silo e per configurare e controllare Auger sulla tua Apple TV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Augerはローカルネットワークを使用して、Siloサーバーを検出したり、Apple TV のAugerを設定・操作したりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger는 로컬 네트워크를 사용해 Silo 서버를 찾고, Apple TV에서 Auger를 설정하고 제어해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auger“ naudoja jūsų vietinį tinklą, kad rastų „Silo“ serverius, taip pat kad nustatytų ir valdytų „Auger“ jūsų „Apple TV“ įrenginyje."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger izmanto jūsu lokālo tīklu, lai atrastu Silo serverus, kā arī lai iestatītu un vadītu Auger jūsu Apple TV ierīcē."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger menggunakan rangkaian setempat anda untuk mencari pelayan Silo, serta untuk menyediakan dan mengawal Auger pada Apple TV anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger bruker det lokale nettverket ditt til å finne Silo-servere og til å konfigurere og styre Auger på Apple TV-en din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger gebruikt je lokale netwerk om Silo-servers te vinden, en om Auger op je Apple TV in te stellen en te bedienen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger używa sieci lokalnej do wyszukiwania serwerów Silo oraz do konfigurowania aplikacji Auger na urządzeniu Apple TV i sterowania nią."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Auger usa sua rede local para encontrar servidores Silo e para configurar e controlar o Auger na sua Apple TV."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Auger usa a sua rede local para encontrar servidores Silo e para configurar e controlar o Auger na sua Apple TV."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger folosește rețeaua locală pentru a găsi servere Silo și pentru a configura și controla Auger pe Apple TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger использует локальную сеть, чтобы находить серверы Silo, а также настраивать Auger на вашем Apple TV и управлять им."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger používa vašu lokálnu sieť na vyhľadávanie serverov Silo a na nastavenie a ovládanie aplikácie Auger na vašom Apple TV."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger uporablja vaše lokalno omrežje za iskanje strežnikov Silo ter za nastavitev in upravljanje aplikacije Auger v napravi Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger använder ditt lokala nätverk för att hitta Silo-servrar och för att konfigurera och styra Auger på din Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger ใช้เครือข่ายภายในเพื่อค้นหาเซิร์ฟเวอร์ Silo และเพื่อตั้งค่าและควบคุม Auger บน Apple TV"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger, Silo sunucularını bulmak ve Apple TV’nizde Auger’ı kurmak ve kontrol etmek için yerel ağınızı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger використовує вашу локальну мережу, щоб знаходити сервери Silo, а також налаштовувати Auger на Apple TV і керувати ним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger dùng mạng cục bộ của bạn để tìm máy chủ Silo, cũng như để thiết lập và điều khiển Auger trên Apple TV."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger使用你的本地网络查找Silo服务器，以及在你的Apple TV上设置和控制Auger。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Auger 會使用你的區域網路來尋找 Silo 伺服器，以及在你的 Apple TV 上設定和控制 Auger。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
