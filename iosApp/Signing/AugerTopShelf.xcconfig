// Top Shelf extension signing defaults. CI and the paid team use these
// as-is. Local contributors without access to the paid team can override
// any of these by dropping a `Local.xcconfig` into this directory — see
// `Local.xcconfig.sample` for the template.
//
// Indirection via `AUGER_TOPSHELF_BUNDLE_ID` /
// `AUGER_TOPSHELF_ENTITLEMENTS` lets Local.xcconfig swap values
// without touching the other targets' xcconfigs.

AUGER_TOPSHELF_BUNDLE_ID = com.artic0din.auger.topshelf
AUGER_TOPSHELF_ENTITLEMENTS = TopShelf/TopShelf.entitlements
SILO_USER_INDEPENDENT_KEYCHAIN = YES

PRODUCT_BUNDLE_IDENTIFIER = $(AUGER_TOPSHELF_BUNDLE_ID)
CODE_SIGN_ENTITLEMENTS = $(AUGER_TOPSHELF_ENTITLEMENTS)

#include? "Local.xcconfig"
