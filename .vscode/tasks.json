{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auger: Generate Xcode project",
      "type": "shell",
      "command": "xcodegen",
      "args": [
        "generate"
      ],
      "options": {
        "cwd": "${workspaceFolder}/iosApp"
      },
      "problemMatcher": []
    },
    {
      "label": "Auger: Build tvOS",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "build",
        "-project",
        "Auger.xcodeproj",
        "-scheme",
        "Auger",
        "-destination",
        "generic/platform=tvOS Simulator",
        "-derivedDataPath",
        ".deriveddata",
        "CODE_SIGN_IDENTITY=",
        "CODE_SIGNING_ALLOWED=NO"
      ],
      "options": {
        "cwd": "${workspaceFolder}/iosApp"
      },
      "dependsOn": "Auger: Generate Xcode project",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$swiftc"
      ]
    },
    {
      "label": "Auger: Test tvOS",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "test",
        "-project",
        "Auger.xcodeproj",
        "-scheme",
        "Auger",
        "-destination",
        "${input:tvosTestDestination}",
        "-derivedDataPath",
        ".deriveddata",
        "CODE_SIGN_IDENTITY=-",
        "CODE_SIGNING_ALLOWED=YES"
      ],
      "options": {
        "cwd": "${workspaceFolder}/iosApp"
      },
      "dependsOn": "Auger: Generate Xcode project",
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$swiftc"
      ]
    }
  ],
  "inputs": [
    {
      "id": "tvosTestDestination",
      "type": "promptString",
      "description": "Installed tvOS Simulator destination",
      "default": "platform=tvOS Simulator,name=Apple TV 4K (3rd generation)"
    }
  ]
}
